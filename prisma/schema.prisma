generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Domain {
  FINANCE
  HEALTH
  GENERAL
}

enum EventSource {
  MANUAL
  RECURRING
  IMPORTED
  LOGGED
}

enum EventStatus {
  PLANNED
  COMPLETED
  SKIPPED
  CANCELLED
}

enum RecurringRuleType {
  MONTHLY
  WEEKLY
  DAILY
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  name             String?
  timezone         String            @default("UTC")
  createdAt        DateTime          @default(now())
  workspaces       Workspace[]
  syncProfile      SyncProfile?
  aiCaptureSources     AiCaptureSource[]
  aiConversations      AiConversation[]
  aiActivityEvents     AiActivityEvent[]
  aiArtifacts          AiArtifact[]
  aiLinks              AiLink[]
  aiExtensionDevices   AiExtensionDevice[]
  aiPairingCodes       AiPairingCode[]
}

model SyncProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt DateTime @updatedAt
}

model SyncChatMessage {
  id        String   @id @default(uuid())
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Fixed-window chat API metering. subjectId is trusted identity.user.id.
model ChatRateLimitWindow {
  id          String   @id @default(uuid())
  subjectId   String
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([subjectId, windowStart])
  @@index([windowStart])
}

enum TimelineItemStatus {
  PLANNED
  COMPLETED
  DUE
}

model Workspace {
  id             String          @id @default(uuid())
  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime        @default(now())
  categories     Category[]
  events         Event[]
  transactions   Transaction[]
  recurringRules RecurringRule[]
  budgets        Budget[]
  timelineItems  TimelineItem[]
}

model TimelineItem {
  id          String              @id @default(uuid())
  workspaceId String
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  category    String
  date        DateTime            @db.Date
  status      TimelineItemStatus  @default(PLANNED)
  detail      Json?
  createdAt   DateTime            @default(now())

  @@index([workspaceId, date])
}

model Category {
  id             String          @id @default(uuid())
  workspaceId    String
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  domain         Domain
  name           String
  color          String?
  events         Event[]
  transactions   Transaction[]
  budgetLines    BudgetLine[]
  recurringRules RecurringRule[]

  @@unique([workspaceId, domain, name])
}

model Event {
  id              String         @id @default(uuid())
  workspaceId     String
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  domain          Domain
  title           String
  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id])
  startsAt        DateTime
  allDay          Boolean        @default(true)
  status          EventStatus    @default(PLANNED)
  source          EventSource
  recurringRuleId String?
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id])
  amountCents     Int?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  transaction     Transaction?

  @@index([workspaceId, startsAt])
  @@index([workspaceId, domain, startsAt])
}

model Transaction {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  eventId     String?   @unique
  event       Event?    @relation(fields: [eventId], references: [id])
  name        String
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  amountCents Int
  currency    String    @default("USD")
  occurredAt  DateTime
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([workspaceId, occurredAt])
}

model RecurringRule {
  id           String            @id @default(uuid())
  workspaceId  String
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  domain       Domain
  title        String
  categoryId   String?
  category     Category?         @relation(fields: [categoryId], references: [id])
  ruleType     RecurringRuleType
  ruleConfig   Json
  amountCents  Int?
  durationMin  Int?
  active       Boolean           @default(true)
  startsOn     DateTime          @db.Date
  endsOn       DateTime?         @db.Date
  events       Event[]
}

model Budget {
  id          String       @id @default(uuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  active      Boolean      @default(true)
  lines       BudgetLine[]
}

model BudgetLine {
  id         String   @id @default(uuid())
  budgetId   String
  budget     Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  limitCents Int

  @@unique([budgetId, categoryId])
}

model AiProvider {
  id               String            @id @default(uuid())
  slug             String            @unique
  displayName      String
  supportedOrigins Json
  createdAt        DateTime          @default(now())
  sources          AiCaptureSource[]
  conversations    AiConversation[]
  activityEvents   AiActivityEvent[]
  artifacts        AiArtifact[]
}

model AiCaptureSource {
  id              String            @id @default(uuid())
  ownerId         String
  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind            String
  providerId      String
  provider        AiProvider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  external        Boolean           @default(false)
  connectionId    String
  permissionState String
  lastSeenAt      DateTime?
  createdAt       DateTime          @default(now())
  revokedAt       DateTime?
  conversations   AiConversation[]
  activityEvents  AiActivityEvent[]

  @@unique([ownerId, providerId, kind, connectionId])
  @@index([ownerId, permissionState])
}

model AiConversation {
  id                      String            @id @default(uuid())
  ownerId                 String
  owner                   User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  providerId              String
  provider                AiProvider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  sourceId                String
  source                  AiCaptureSource   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  providerConversationRef String
  idempotencyKey          String?
  title                   String?
  origin                  String
  startedAt               DateTime?
  lastMessageAt           DateTime?
  capturedAt              DateTime
  captureMethod           String
  visibility              String
  rawTextRef              String?
  summary                 String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  messages                AiMessage[]
  activityEvents          AiActivityEvent[]
  artifacts               AiArtifact[]

  @@unique([ownerId, providerId, providerConversationRef])
  @@unique([ownerId, providerId, idempotencyKey])
  @@index([ownerId, capturedAt])
}

model AiMessage {
  id                 String         @id @default(uuid())
  conversationId     String
  conversation       AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  providerMessageRef String
  role               String
  text               String
  redactedText       String
  redactionStatus    String
  sentAt             DateTime?
  capturedAt         DateTime
  confidence         Float
  visibility         String
  metadata           Json?
  activityEvents     AiActivityEvent[]

  @@unique([conversationId, providerMessageRef])
  @@index([conversationId, sentAt])
}

model AiActivityEvent {
  id              String          @id @default(uuid())
  ownerId         String
  owner           User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  conversationId  String
  conversation    AiConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId       String?
  message         AiMessage?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  kind            String
  actorKind       String
  actorId         String?
  actorLabel      String?
  providerId      String
  provider        AiProvider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  sourceId        String
  source          AiCaptureSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  timestamp       DateTime
  summary         String
  affectedAreas   Json
  evidence        Json
  verification    String
  confidence      Float
  reversibility   String
  permissionScope String
  permissionState String
  visibility      String
  correlationId   String?
  relatedEventIds Json?
  detail          Json?
  createdAt       DateTime        @default(now())
  artifacts       AiArtifact[]
  outgoingLinks   AiLink[]        @relation("AiLinkFromEvent")
  incomingLinks   AiLink[]        @relation("AiLinkToEvent")

  @@unique([ownerId, providerId, correlationId])
  @@index([ownerId, timestamp])
  @@index([conversationId, timestamp])
}

model AiArtifact {
  id              String           @id @default(uuid())
  ownerId         String
  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  providerId      String
  provider        AiProvider       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  conversationId  String
  conversation    AiConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  activityEventId String?
  activityEvent   AiActivityEvent? @relation(fields: [activityEventId], references: [id], onDelete: SetNull)
  kind            String
  title           String
  summary         String?
  artifactRef     String?
  createdAt       DateTime         @default(now())
  visibility      String

  @@index([ownerId, createdAt])
  @@index([conversationId])
}

model AiLink {
  id           String          @id @default(uuid())
  ownerId      String
  owner        User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  fromEventId  String
  fromEvent    AiActivityEvent @relation("AiLinkFromEvent", fields: [fromEventId], references: [id], onDelete: Cascade)
  toEventId    String
  toEvent      AiActivityEvent @relation("AiLinkToEvent", fields: [toEventId], references: [id], onDelete: Cascade)
  relationship String
  confidence   Float
  basis        String
  evidence     Json
  createdAt    DateTime        @default(now())
  confirmedAt  DateTime?
  rejectedAt   DateTime?

  @@unique([ownerId, fromEventId, toEventId, relationship])
  @@index([ownerId, createdAt])
}

model AiExtensionDevice {
  id              String    @id @default(uuid())
  ownerId         String
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  connectionId    String
  tokenHash       String    @unique
  label           String?
  permissionState String
  createdAt       DateTime  @default(now())
  lastSeenAt      DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?

  @@unique([ownerId, connectionId])
  @@index([ownerId, permissionState])
}

model AiPairingCode {
  id         String    @id @default(uuid())
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  codeHash   String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([ownerId, expiresAt])
}
