# ── Database (Prisma + Next.js) ──────────────────────────────────────────────
# Prisma CLI reads .env only. Next.js dev reads .env.local — keep both in sync.
#
# Supabase: Project Settings -> Database -> Connection string (URI)
#   Direct (recommended for db:push / db:seed): host db.*.supabase.co, port 5432
#   Pooler (port 6543): append ?pgbouncer=true
#
# Neon: Dashboard -> Connect -> connection string

DATABASE_URL=

# ── Supabase Auth + API ───────────────────────────────────────────────────────
# Project Settings -> API Keys -> publishable key (sb_publishable_...) or legacy anon JWT.
# NEVER put the service_role / secret key (sb_secret_...) in NEXT_PUBLIC_* variables.
# Auth: enable Email provider in Supabase Dashboard → Authentication → Providers.
# Site URL should match the deployed origin (e.g. https://finance-calender-g6ay.vercel.app).
# Also add that origin + `/auth/callback` and `/auth/reset-password` under
# Authentication → URL Configuration → Redirect URLs.

NEXT_PUBLIC_SUPABASE_URL=paste_your_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste_your_anon_key_here

# Canonical public origin for metadata, magic-link redirects, and the add-on.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional server-only Supabase key for privileged API access (never NEXT_PUBLIC_*).
# Required to delete Auth users when someone deletes their Sync account.
# Project Settings → API Keys → service_role (secret).
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Public flags only. Provider credentials live in the Supabase dashboard
# (Authentication → Providers). Set to "true" to show the button; leave unset to hide.
# NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# NEXT_PUBLIC_AUTH_APPLE_ENABLED=false

# Sign in with Apple token revocation (required if Apple is enabled — do not no-op).
# Apple Developer → Identifiers → Services ID (APPLE_CLIENT_ID)
# Membership → Team ID (APPLE_TEAM_ID)
# Keys → Sign in with Apple key (APPLE_KEY_ID + .p8 contents as APPLE_PRIVATE_KEY)
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# ── OpenAI (server-only chat; never NEXT_PUBLIC_*) ────────────────────────────
# Missing or invalid key: authenticated /api/chat returns 503, not a client key.
# /api/chat requires trusted identity (session or explicit SYNC_DEMO_MODE=true).
# Durable per-user rate limiting runs before OpenAI.

OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini. Allowed: gpt-4o-mini, gpt-4o.
OPENAI_MODEL=

# Chat rate limit (trusted identity.user.id subject; Prisma fixed window)
# Defaults: 30 requests per 3600 seconds. Invalid values fail closed (503).
# Production: apply migration `20260813000000_chat_rate_limit_window` before deploy.
SYNC_CHAT_RATE_LIMIT_MAX=30
SYNC_CHAT_RATE_LIMIT_WINDOW_SECONDS=3600

# Ingest / pair / claim / login / signup (same ChatRateLimitWindow table).
# Missing values use the defaults below. Invalid values fail closed (503) in production.
# SYNC_INGEST_RATE_LIMIT_MAX=60
# SYNC_INGEST_RATE_LIMIT_WINDOW_SECONDS=3600
# SYNC_PAIR_RATE_LIMIT_MAX=20
# SYNC_PAIR_RATE_LIMIT_WINDOW_SECONDS=3600
# SYNC_CLAIM_RATE_LIMIT_MAX=30
# SYNC_CLAIM_RATE_LIMIT_WINDOW_SECONDS=3600
# SYNC_LOGIN_RATE_LIMIT_MAX=10
# SYNC_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# SYNC_SIGNUP_RATE_LIMIT_MAX=5
# SYNC_SIGNUP_RATE_LIMIT_WINDOW_SECONDS=3600

# ── Local demo API identity (server routes only) ──────────────────────────────
# Disabled by default. Must be the exact value "true" to enable.
# Never activates merely because auth vars are missing.
# Always ignored when NODE_ENV=production (production fails closed to auth).

SYNC_DEMO_MODE=false

# ── Capture encryption at rest (AES-256-GCM) ──────────────────────────────────
# 32-byte key as 64 hex characters. Generate with: openssl rand -hex 32
# Required in production. Never commit a real key.
# After setting this, encrypt existing plaintext rows:
#   npx tsx scripts/encrypt-existing-captures.ts
# SYNC_CAPTURE_ENCRYPTION_KEY=

# Transactional email only (account deletion confirmation).
# Verification and password-reset mail still come from Supabase Auth.
# Leave unset to skip the extra deletion mail. Never used for marketing.
# RESEND_API_KEY=
# EMAIL_FROM=Sync <noreply@your-domain.example>

# Optional error monitoring. Leave unset to send nothing.
# Server/edge only unless NEXT_PUBLIC_SENTRY_DSN is also set (browser SDK).
# Events are scrubbed: no emails, tokens, cookies, or capture bodies.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Published Chrome extension ID (32 chars, a–p). Comma-separated if several.
# Localhost origins are allowed only outside production.
# SYNC_EXTENSION_IDS=

# ── Owner-only AI activity ingest (lab/dev fallback) ──────────────────────────
# Optional. Consumer pairing uses a signed-in session. Lab may still present
# this as Authorization: Bearer <secret> or X-Sync-Owner-Secret.
# The Chrome extension should pair with a short-lived code instead of storing this.

SYNC_OWNER_SECRET=
# Optional. Defaults to sync-owner / owner@sync.local
# SYNC_OWNER_ID=
# SYNC_OWNER_EMAIL=
