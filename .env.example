# ── Database (Prisma + Next.js) ──────────────────────────────────────────────
# Prisma CLI reads .env only. Next.js dev reads .env.local — keep both in sync.
#
# Supabase: Project Settings -> Database -> Connection string (URI)
#   Direct (recommended for db:push / db:seed): host db.*.supabase.co, port 5432
#   Pooler (port 6543): append ?pgbouncer=true
#
# Neon: Dashboard -> Connect -> connection string

DATABASE_URL=

# ── Supabase Auth + API ───────────────────────────────────────────────────────
# Project Settings -> API Keys -> publishable key (sb_publishable_...) or legacy anon JWT.
# NEVER put the service_role / secret key (sb_secret_...) in NEXT_PUBLIC_* variables.
# Auth: enable Email provider in Supabase Dashboard → Authentication → Providers.
# Site URL should match the deployed origin (e.g. https://finance-calender-g6ay.vercel.app).

NEXT_PUBLIC_SUPABASE_URL=paste_your_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste_your_anon_key_here

# Optional server-only Supabase key for privileged API access (never NEXT_PUBLIC_*).
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# ── Optional OpenAI (chat fallback route) ─────────────────────────────────────
# Without this key, authenticated chat returns a local Sync-voice fallback reply.
# /api/chat requires trusted identity (session or explicit SYNC_DEMO_MODE=true).
# Durable per-user rate limiting runs before OpenAI/fallback.

OPENAI_API_KEY=

# Chat rate limit (trusted identity.user.id subject; Prisma fixed window)
# Defaults: 30 requests per 3600 seconds. Invalid values fail closed (503).
# Production: apply migration `20260813000000_chat_rate_limit_window` before deploy.
SYNC_CHAT_RATE_LIMIT_MAX=30
SYNC_CHAT_RATE_LIMIT_WINDOW_SECONDS=3600

# ── Local demo API identity (server routes only) ──────────────────────────────
# Disabled by default. Must be the exact value "true" to enable.
# Never activates merely because auth vars are missing.
# Always ignored when NODE_ENV=production (production fails closed to auth).

SYNC_DEMO_MODE=false
