# Prisma CLI reads this file only (not .env.local).

# Supabase — pick ONE connection string from Project Settings -> Database:
#
# Easiest (recommended for db:push / db:seed):
#   "Direct connection" — host db.*.supabase.co, port 5432
#
# Or transaction pooler (port 6543) — you MUST add ?pgbouncer=true at the end:
#   ...pooler.supabase.com:6543/postgres?pgbouncer=true
#
# Paste your real URL on the line below (keep the quotes):

DATABASE_URL=
